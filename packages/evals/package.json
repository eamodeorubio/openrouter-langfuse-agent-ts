{
  "name": "ask-openrouter-evals",
  "version": "0.0.0",
  "private": true,
  "description": "Evals of the ask-openrouter agent: real models, real services, run only on request.",
  "license": "MIT",
  "author": "Enrique Javier Amodeo Rubio <eamodeorubio@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx src/run.ts",
    "report": "tsx src/report/main.ts",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "calibrate": "tsx src/calibrate/main.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "^4.10.2",
    "promptfoo": "0.125.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.12",
    "yaml": "^2.9.1"
  }
}

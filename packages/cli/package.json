{
  "name": "openrouter-langfuse-agent-ts",
  "version": "0.0.0",
  "description": "A small CLI that answers questions about OpenRouter, helping users discover the most cost-effective model for their use case.",
  "license": "MIT",
  "private": true,
  "author": "Enrique Javier Amodeo Rubio <eamodeorubio@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "^4.10.2",
    "nock": "^15.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eamodeorubio/openrouter-langfuse-agent-ts.git"
  },
  "bugs": {
    "url": "https://github.com/eamodeorubio/openrouter-langfuse-agent-ts/issues"
  },
  "homepage": "https://eamodeorubio.github.io/openrouter-langfuse-agent-ts/"
}

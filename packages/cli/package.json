{
  "name": "ask-openrouter",
  "version": "1.2.2",
  "description": "A small CLI that answers questions about OpenRouter, helping users discover the most cost-effective model for their use case.",
  "license": "MIT",
  "author": "Enrique Javier Amodeo Rubio <eamodeorubio@gmail.com>",
  "type": "module",
  "bin": {
    "ask-openrouter": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openrouter",
    "llm",
    "cli",
    "ai",
    "models",
    "pricing",
    "cost",
    "langfuse"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "prepack": "rm -rf dist && pnpm run build && tsx scripts/prepack.ts",
    "pack:check": "tsx scripts/check-pack.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "^8.20.0",
    "fast-check": "^4.11.0",
    "nock": "^15.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eamodeorubio/openrouter-langfuse-agent-ts.git"
  },
  "bugs": {
    "url": "https://github.com/eamodeorubio/openrouter-langfuse-agent-ts/issues"
  },
  "homepage": "https://eamodeorubio.github.io/openrouter-langfuse-agent-ts/",
  "dependencies": {
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@openrouter/sdk": "^1.5.142",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "zod": "^4.6.7"
  }
}

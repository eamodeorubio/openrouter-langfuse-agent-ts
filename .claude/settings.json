{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm build)",
      "Bash(pnpm docs:build)",
      "Bash(openspec list:*)",
      "Bash(openspec status:*)",
      "Bash(openspec show:*)",
      "Bash(openspec validate:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec schemas:*)",
      "Bash(openspec --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  }
}

# Copy to .env and fill in. Never commit .env.
# The CLI reads .env from the directory it runs in. `pnpm dev` runs in
# packages/cli/, so put the file there: cp .env.example packages/cli/.env

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# The model that answers your question, for example openai/gpt-4o-mini.
# There is no default. `--model` overrides it.
OPENROUTER_MODEL=

# Langfuse tracing: uncomment all three to trace every run, leave all three
# commented to run without tracing. Project settings > API keys.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Use https://us.cloud.langfuse.com for the US region, or your self-hosted URL.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional, with tracing on. The environment is where the traces are filed (default: "default"),
# the release is what they are attributed to (default: the version of this tool).
# LANGFUSE_TRACING_ENVIRONMENT=staging
# LANGFUSE_RELEASE=
